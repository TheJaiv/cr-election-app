# ---------------------------------------------------------------------------
# Auth.js / NextAuth
# ---------------------------------------------------------------------------
# Random 32+ byte secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Only needed for local dev and preview deploys; Vercel sets the production URL
# automatically. Must exactly match the origin you browse to.
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google OAuth (Sign in with Google) — see SETUP.md step 2
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Who may sign in. Set the domain, the explicit list, or both.
# An account is allowed if it is on ALLOWED_EMAILS, OR it matches
# ALLOWED_EMAIL_DOMAIN (further narrowed by ALLOWED_EMAIL_LOCAL_SUFFIX).
# If neither is set, EVERYONE is rejected — it fails closed on purpose.
# ---------------------------------------------------------------------------
ALLOWED_EMAIL_DOMAIN=itbhu.ac.in

# Optional. Requires the part before the @ to end with this string, so only
# <name>.cse26@itbhu.ac.in can sign in. Leave blank to allow any local part.
ALLOWED_EMAIL_LOCAL_SUFFIX=.cse26

# Optional comma-separated exceptions (e.g. your own account for testing).
ALLOWED_EMAILS=

# ---------------------------------------------------------------------------
# Google Sheets service account — see SETUP.md step 3
# ---------------------------------------------------------------------------
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=cr-election@your-project.iam.gserviceaccount.com
# The full private key from the service account JSON, including the BEGIN/END
# lines. Keep the literal \n escapes and wrap the whole value in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Admin panel (/admin) — separate from the Google login
# ---------------------------------------------------------------------------
# Generate with: npm run hash-password -- "your admin password"
# Store the HASH only. The plaintext password never goes in an env var.
ADMIN_PASSWORD_HASH=
